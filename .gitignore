data/hundred-theorems/data/_lean4_source_map.json

# Evaluation
.env
eval/.env
eval/results/

# Python packaging
*.egg-info/
dist/

# Scratch / temp
*.tmp
*.bak
*.swp
*~

/notes/

# Local V2 DSP dependencies and runtime configuration
/external/
/eval/configs/hol_light_to_isabelle/*.local.json

# Isolated Qwen/vLLM server artifacts
/vllm/env/
/vllm/models/
/vllm/cache/
/vllm/logs/
/vllm/*.local.json
/eval/configs/inference/*.local.json

# Compact preflight reports only. Full logs/artifacts stay in itpeval/.runs/.
# Ignore legacy ZIPs and per-check/runtime trees even when `git add .` is used.
/eval/preflight_results/**
!/eval/preflight_results/**/
!/eval/preflight_results/**/README.md
!/eval/preflight_results/*/*/report.json
!/eval/preflight_results/*/*/summary.md
!/eval/preflight_results/*/*/checks.jsonl
!/eval/preflight_results/*/*/metadata.json
!/eval/preflight_results/*/*/logs.jsonl
!/eval/preflight_results/*/*/unavailable_contexts.json
/eval/preflight_results/**/*.zip
/eval/preflight_results/**/*.tmp
